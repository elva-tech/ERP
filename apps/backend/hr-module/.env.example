# Copy to .env.local and fill in real values. Never commit .env.local.

# PostgreSQL connection used by the API (pg pool) and by Prisma CLI commands.
# URL-encode special characters in the password (for example "@" becomes "%40").
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hrms_db

# Comma-separated browser origins allowed to call the API with cookies.
# In development http://localhost:5173 and http://127.0.0.1:5173 are always allowed.
# In production ONLY the origins listed here are allowed.
ALLOWED_ORIGINS=http://localhost:5173

# IANA time zone used for attendance dates and late/overtime calculations.
HRMS_TIMEZONE=Asia/Kolkata

# Login rate limiting (stored in the login_attempts table).
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
# Set to true only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
TRUST_PROXY_HEADERS=false

# Private employee-document storage (never under public/). Defaults to
# <app>/storage/documents. In production mount a durable, backed-up private
# volume here. Use a separate directory for a test backend.
# DOCUMENT_STORAGE_DIR=D:/hrms-private/documents
# Per-file upload limit in bytes (default 5 MB, hard cap 25 MB).
DOCUMENT_MAX_BYTES=5242880
