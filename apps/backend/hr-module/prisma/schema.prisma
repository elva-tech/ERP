/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_records {
  id               BigInt    @id @default(autoincrement())
  company_id       BigInt
  employee_id      BigInt
  shift_id         BigInt?
  attendance_date  DateTime  @db.Date
  check_in         DateTime? @db.Timestamptz(6)
  check_out        DateTime? @db.Timestamptz(6)
  status           String    @default("Absent") @db.VarChar(30)
  working_minutes      Int?
  overtime_minutes     Int?      @default(0)
  overtime_status      String?   @db.VarChar(20)
  overtime_reason      String?
  overtime_review_note String?
  overtime_reviewed_by BigInt?
  overtime_reviewed_at DateTime? @db.Timestamptz(6)
  is_regularized       Boolean   @default(false)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)
  companies            companies @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees            employees @relation(fields: [employee_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "attendance_records_employee_company_fkey")
  shifts               shifts?   @relation(fields: [shift_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "attendance_records_shift_company_fkey")
  overtime_reviewer    users?    @relation("attendance_overtime_reviewer", fields: [overtime_reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "attendance_records_overtime_reviewer_fkey")

  @@unique([company_id, employee_id, attendance_date])
  @@index([company_id, attendance_date], map: "idx_attendance_company_date")
  @@index([employee_id, attendance_date], map: "idx_attendance_employee_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_regularizations {
