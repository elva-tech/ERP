  status              String    @default("Pending") @db.VarChar(20)
  reviewed_by         BigInt?
  reviewed_at         DateTime? @db.Timestamptz(6)
  review_note         String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  companies           companies @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees           employees @relation(fields: [employee_id, company_id], references: [id, company_id], onDelete: NoAction, onUpdate: NoAction, map: "attendance_regularizations_employee_company_fkey")
  users               users?    @relation(fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id, status], map: "idx_regularizations_company")
}

