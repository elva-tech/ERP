# API Mode: 'mock' for local multi-tenant mock testing adapter, 'real' for production backend
VITE_API_MODE=mock

# Base URL for the production backend API (required when VITE_API_MODE=real)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# In production mode, tenant identity and organization context are strictly derived
# from the authenticated backend session. Client-side tenant ID injection is disabled.
