# Mode: "mock" (default for standalone development) or "real" (for production backend integration)
VITE_API_MODE=real

# Base URL for the real Inventory backend API (used when VITE_API_MODE=real)
VITE_API_BASE_URL=http://localhost:3000/api/inventory

# Tenant configuration (can be customized per customer deployment)
VITE_TENANT_NAME=SB PATIL GROUP
VITE_TENANT_SUBTITLE=INVENTORY MANAGEMENT

# Optional mock network delay simulation in milliseconds (0 for immediate)
VITE_MOCK_DELAY_MS=0

