# Copy to `.env.local` (git-ignored via `*.local`) and set the value for your environment.
# Do not put secrets here: every VITE_* variable is embedded in the browser bundle.

# Required. Base URL of the Procurement API, without a trailing slash.
# Request paths in src/features/**/*Service.js are appended to it, e.g. `${VITE_API_BASE_URL}/procurement/suppliers`.
# May be absolute (https://api.example.com/api/v1) or same-origin relative (/api/v1).
# When empty or unset, no request is sent and every screen shows "Procurement service not connected".
# Requests use `credentials: "include"`, so a cross-origin backend must allow credentialed CORS for this origin.
VITE_API_BASE_URL=
